{
  "name": "starbonds-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "STARBONDS promo motion video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:vertical": "remotion render src/index.ts PromoVertical out/starbonds-promo-vertical.mp4 --codec=h264 --crf=16 --concurrency=2",
    "render:horizontal": "remotion render src/index.ts PromoHorizontal out/starbonds-promo-horizontal.mp4 --codec=h264 --crf=16 --concurrency=2",
    "posters": "remotion still src/index.ts PromoVertical out/starbonds-promo-vertical-poster.png --frame=380 && remotion still src/index.ts PromoHorizontal out/starbonds-promo-horizontal-poster.png --frame=380",
    "render": "npm run render:vertical && npm run render:horizontal && npm run posters",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.533",
    "@remotion/google-fonts": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
