# Supabase project (Settings > API). Use the publishable key, never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public URL of the app (used for auth redirects). In Vercel: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
